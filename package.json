{
  "name": "paste2speech",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/release.mjs",
    "test:worker": "node --test tests/worker.test.js",
    "build:reader:production": "node cloudflare/reader/build.mjs --production --mse-production",
    "release:reader:production": "node scripts/release-reader-production.mjs",
    "build:reader:public": "node cloudflare/reader/build.mjs --public",
    "release:reader:public": "node scripts/release-reader-public.mjs",
    "build:reader:staging": "node cloudflare/reader/build.mjs --mse-staging",
    "release:reader:staging": "node scripts/release-reader.mjs --staging",
    "check:reader:parity": "node scripts/reader-parity/check.mjs",
    "check:reader:resume": "node scripts/reader-parity/check-resume.mjs",
    "check:reader:reload": "node scripts/reader-parity/check-reload.mjs",
    "build:extension": "node scripts/chrome-extension/build.mjs",
    "check:extension": "node scripts/chrome-extension/check.mjs",
    "package:extension": "npm run build:extension && python3 scripts/chrome-extension/package.py",
    "check:reader:previews": "node scripts/reader-parity/check-previews.mjs",
    "check:reader:documents": "node scripts/reader-parity/check-documents.mjs",
    "check:reader:recovery": "node scripts/reader-parity/check-media-recovery.mjs && node scripts/reader-parity/check-status-recovery.mjs && node scripts/reader-parity/check-full-reading.mjs && node tests/playback-recovery-browser.mjs && node tests/playback-interruption-browser.mjs",
    "check:reader:progress": "node tests/section-progress-browser.mjs",
    "check:reader:modes": "node tests/mode-controls-browser.mjs",
    "check:reader:paste": "node scripts/reader-parity/check-paste.mjs",
    "check:reader:unified": "node tests/unified-wallet-browser.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@huggingface/transformers": "3.8.1",
    "@mathjax/src": "4.1.3",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "phonemizer": "1.2.1",
    "speech-rule-engine": "4.1.5",
    "wicked-good-xpath": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "wrangler": "4.151.2"
  },
  "overrides": {
    "sharp": "0.35.5",
    "onnxruntime-node": {
      "global-agent": "4.1.3"
    }
  }
}
