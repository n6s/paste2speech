{
  "name": "paste2speech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/release.mjs",
    "test:worker": "node --test tests/worker.test.js",
    "build:reader:production": "node cloudflare/reader/build.mjs --production --mse-production",
    "release:reader:production": "node scripts/release-reader-production.mjs",
    "build:reader:public": "node cloudflare/reader/build.mjs --public",
    "release:reader:public": "node scripts/release-reader-public.mjs",
    "build:reader:staging": "node cloudflare/reader/build.mjs --mse-staging",
    "release:reader:staging": "node scripts/release-reader.mjs --staging",
    "check:reader:parity": "node scripts/reader-parity/check.mjs",
    "check:reader:resume": "node scripts/reader-parity/check-resume.mjs",
    "build:extension": "node scripts/chrome-extension/build.mjs",
    "check:extension": "node scripts/chrome-extension/check.mjs",
    "package:extension": "npm run build:extension && python3 scripts/chrome-extension/package.py",
    "check:reader:previews": "node scripts/reader-parity/check-previews.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@huggingface/transformers": "3.8.1",
    "pdfjs-dist": "6.3.289",
    "phonemizer": "1.2.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
