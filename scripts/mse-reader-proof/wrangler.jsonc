{
  "name": "local-mse-reader-proof",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"MSE_LOCAL_PROOF":"1", "ENABLE_LIVE_SYNTHESIS":"0"},
  "assets": {"directory":"../../work/mse-reader-proof/site", "binding":"ASSETS", "run_worker_first":true},
  "durable_objects": {"bindings":[{"name":"JOBS","class_name":"MseReading"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["MseReading"]}],
  "r2_buckets": [{"binding":"AUDIO","bucket_name":"mse-reader-proof-local"}]
}
