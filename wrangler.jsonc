 "d1_databases":[{"binding":"DB","database_name":"paste2speech","database_id":"5499d01a-aa14-460d-97b9-100ece1293d3","migrations_dir":"migrations"}],
 "ratelimits":[
  {"name":"EVENT_LIMIT","namespace_id":"1001","simple":{"limit":60,"period":60}},
  {"name":"FEEDBACK_LIMIT","namespace_id":"1002","simple":{"limit":6,"period":60}}
 ],
 "triggers":{"crons":["*/5 * * * *"]},
 "observability":{"enabled":false}
}
