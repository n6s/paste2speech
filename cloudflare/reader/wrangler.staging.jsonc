{
  "name": "private-wavenet-reader-staging",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENABLE_SUMMARY_UI": "1",
    "SUMMARY_LIVE_APPROVED": "1",
    "SUMMARY_PRICE_CREDITS": "1",
    "SUMMARY_ALLOWANCE_MODE": "upstream-free-daily",
    "SUMMARY_WORKERS_PLAN": "free",
    "OCR_RETAIL_SANDBOX": "1",
    "OCR_RETAIL_PROVIDER_MODE": "live",
    "ENABLE_OCR_PAYMENTS": "1",
    "PADDLE_OCR_PRODUCT_ID": "pro_01m4dzha8772sp5eezdtz2c0cz",
    "PADDLE_OCR_PRICE_ID": "pri_01m4dzmjgsjt3feew9j7maj8w5",
    "ENABLE_DOCUMENT_OCR": "1",
    "OCR_LIVE_APPROVED": "1",
    "OCR_OWNER_DOCUMENTS": "1",
    "OCR_DIAGNOSTIC_REVISION": "manual-redirect",
    "OCR_DIAGNOSTIC_ATTEMPT": "95eed1f1-626f-4dd2-8a6f-c9b0705af07a",
    "OWNER_EMAIL": "rogerpbrown@gmail.com",
    "BACKGROUND_WORK_PAUSED": "0",
    "MAINTENANCE_QUEUE_ENABLED": "1",
    "MAINTENANCE_QUEUE_LIMIT": "1",
    "RETIRE_BEFORE": "1790389200000",
    "PRIVATE_READER": "1",
    "LOCAL_READER": "0",
    "ENABLE_LIVE_SYNTHESIS": "1",
    "ENABLE_PAYMENTS": "1",
    "ENABLE_EMAIL": "1",
    "READER_ORIGIN": "https://staging.pastetospeech.com",
    "ACCESS_ISSUER": "https://broad-king-0668.cloudflareaccess.com",
    "ACCESS_AUD": "cc8a795d34c6e3dd7a61e1d12a86f171de6c0764ca83088160ee2baf9d4ba971",
    "READER_MODE": "staging",
    "PADDLE_ENVIRONMENT": "sandbox",
    "PADDLE_PRICE_ID": "pri_01m32vvy2sptegx6arebyvxh37",
    "PADDLE_PRODUCT_ID": "pro_01m32gd3hj94whqywcvmyta74b",
    "MSE_STAGING": "1",
    "VIDEO_DOWNLOAD": "1",
    "OCR_STAGE_OWNER_ONLY": "1",
    "UNIFIED_CREDITS": "1",
    "ENABLE_UNIFIED_PAYMENTS": "1",
    "PADDLE_UNIFIED_PRODUCT_ID": "pro_01m4ntya23sa7g6mr4kv7yepyc",
    "PADDLE_UNIFIED_PRICE_ID": "pri_01m4nv10a0b8nq3tpnp78shzbj",
    "OCR_DURABLE_JOBS": "1",
    "OCR_SOURCE_ORIGIN": "https://private-wavenet-ocr-source-staging.rogerpbrown.workers.dev",
    "OCR_PICKER_AUTOSCAN": "1",
    "INPUT_QUEUE_UI": "1",
    "INPUT_QUEUE_REFINEMENTS": "1",
    "SPEECH_SECTION_RECOVERY": "1",
    "LOGIN_FAIR_ALLOWANCE": "1",
    "LOCAL_TEXT_IMPORT": "1",
    "PERSISTENT_AUDIO": "1",
    "MATH_SPEECH_PREVIEW": "1",
    "TRANSLATION_UI": "1",
    "TRANSLATION_BILLING_SCHEMA": "1",
    "TRANSLATION_LIVE_APPROVED": "1",
    "TRANSLATION_LIVE_TEST_BUDGET": "0"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../../work/private-reader/site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOBS",
        "class_name": "PreparedReading"
      },
      {
        "name": "PAYMENTS",
        "class_name": "PaymentCoordinator"
      },
      {
        "name": "OCR_PAYMENTS",
        "class_name": "OcrPaymentCoordinator"
      },
      {
        "name": "OCR_JOBS",
        "class_name": "OcrJob"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PreparedReading",
        "PaymentCoordinator"
      ]
    },
    {
      "tag": "v2-ocr-sandbox",
      "new_sqlite_classes": [
        "OcrPaymentCoordinator"
      ]
    },
    {
      "tag": "v3-ocr-jobs",
      "new_sqlite_classes": [
        "OcrJob"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "private-wavenet-reader-staging"
    }
  ],
  "d1_databases": [
    {
      "binding": "LEDGER",
      "database_name": "private-wavenet-reader-staging",
      "database_id": "74f0d55c-b7ab-4d6b-aa26-cf06bfa9036f",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "account_id": "c71dba5be3cc617a904adc61e767704d",
  "routes": [
    {
      "pattern": "staging.pastetospeech.com",
      "custom_domain": true
    },
    {
      "pattern": "speak-staging.rogerpbrown.com",
      "custom_domain": true
    }
  ]
}
