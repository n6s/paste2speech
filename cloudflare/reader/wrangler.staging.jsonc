{
  "name": "private-wavenet-reader-staging",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PRIVATE_READER": "1",
    "LOCAL_READER": "0",
    "ENABLE_LIVE_SYNTHESIS": "0",
    "ENABLE_PAYMENTS": "0",
    "ENABLE_EMAIL": "0",
    "READER_ORIGIN": "https://unconfigured.invalid",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "MAX_LIFETIME_CHARACTERS": "0"
  },
  "assets": {
    "directory": "../../work/private-reader/site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOBS",
        "class_name": "PreparedReading"
      },
      {
        "name": "PAYMENTS",
        "class_name": "PaymentCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PreparedReading",
        "PaymentCoordinator"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "private-reader-staging-unconfigured"
    }
  ],
  "d1_databases": [
    {
      "binding": "LEDGER",
      "database_name": "private-reader-staging-unconfigured",
      "database_id": "REQUIRES_APPROVED_ISOLATED_DATABASE",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
