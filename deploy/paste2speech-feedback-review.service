[Unit]
Description=Review Paste to Speech feedback and send Telegram summaries
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/workarea/paste2speech
ExecStart=/usr/bin/python3 -m scripts.feedback_review run
Environment=PATH=%h/.nvm/versions/node/v24.16.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
UMask=0077
TimeoutStartSec=25min
TimeoutStopSec=15
KillMode=control-group
MemoryMax=2G
